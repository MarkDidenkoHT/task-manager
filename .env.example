# Скопируйте в .env для локального запуска. На Render задайте те же значения в Environment.

# Supabase → Project Settings → API (нужен секретный ключ sb_secret_…, не публикуемый)
SUPABASE_URL=https://muzkjlwstmeodcoxtqlx.supabase.co
SUPABASE_SECRET_KEY=

# Токен бота от @BotFather — сервер проверяет им вход пользователей из Telegram
BOT_TOKEN=

# Только локально: вход без Telegram по адресу http://localhost:3000/?dev=12345
DEV_AUTH=1
