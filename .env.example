# Скопируйте в .env для локального запуска. На Render задайте те же переменные в Environment.

# Supabase → Project Settings → API
SUPABASE_URL=https://muzkjlwstmeodcoxtqlx.supabase.co
# Секретный ключ (sb_secret_... или service_role). НЕ публикуемый (sb_publishable_...)!
# Публикуемый ключ не подходит: RLS запрещает ему всё, а браузер к базе не обращается.
SUPABASE_SECRET_KEY=

# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @ (для ссылок-приглашений t.me/<bot>?startapp=...)
BOT_USERNAME=
# Короткое имя Mini App из @BotFather (/newapp). Пусто — ссылки вида t.me/<bot>?startapp=
WEBAPP_SHORT_NAME=

# Публичный адрес сервиса, например https://life-planner.onrender.com
PUBLIC_URL=

# Случайные строки (openssl rand -hex 32)
TICK_SECRET=
WEBHOOK_SECRET=

PORT=3000

# Только для локальной разработки в обычном браузере: разрешает заголовок "Authorization: dev <tg_id>".
# Никогда не включайте в продакшене.
DEV_AUTH=0
