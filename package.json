{
  "name": "life-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Планировщик жизни: Telegram Mini App (бюджет, питание, тренировки, напоминания)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:exercises": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/scripts/seed-exercises.js",
    "set-webhook": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/scripts/set-webhook.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/logic.test.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@supabase/supabase-js": "^2.119.2",
    "fastify": "^5.12.8",
    "highs": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
